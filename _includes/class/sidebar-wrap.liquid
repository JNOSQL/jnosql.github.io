<aside class="sidebar-wrap" id="sidebar">
    <div class="sidebar">
        <a class="sidebar-brand" href="{{ site.baseurl }}/" title="{{ site.title }}">
            <img src="{{ site.baseurl }}/assets/images/jnosql-logo.png" width="2172" height="724" alt="Eclipse JNoSQL">
        </a>
        <form class="sidebar-search" role="search" action="{{ site.baseurl }}/search.html" method="get" autocomplete="off">
            {%- include icon.liquid name="search" -%}
            <label class="sr-only" for="sidebar-search-input">{{ __.search_docs | default: 'Search docs' }}</label>
            <input id="sidebar-search-input" type="search" name="q" placeholder="{{ __.search_docs | default: 'Search docs...' }}">
        </form>
        {% include class/_toctree.liquid %}
    </div>
</aside>
