{% comment %} prev and next, following the sidebar order {% endcomment %}
{%- if page.url != "/search.html" and page.url != "/404.html" -%}
    {%- if next or prev -%}
        <nav class="page-nav" aria-label="Previous and next page">
            <div class="prev">
                {%- if prev -%}
                    <a href="{{ prev.url | relative_url }}" class="btn" accesskey="p" rel="prev">
                        {%- include icon.liquid name="arrow-left" %} {{ prev.nav_title | default: prev.title }}
                    </a>
                {%- endif -%}
            </div>
            <div class="next">
                {%- if next -%}
                    <a href="{{ next.url | relative_url }}" class="btn" accesskey="n" rel="next">
                        {{ next.nav_title | default: next.title }} {% include icon.liquid name="arrow-right" -%}
                    </a>
                {%- endif -%}
            </div>
        </nav>
    {%- endif -%}
{%- endif -%}
